# Media and build output stay OUT of source control
__pycache__/
*.pyc
.venv/
.pytest_cache/
dist/
projects/*/media/
projects/*/output/
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.zip
.env
*.key

# Voice data stays local: never commit recordings, embeddings or checkpoints
.venv-tts/
voices/
references/
projects/*/voices/
projects/*/media/
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.flac
*.m4a
*.ogg
projects/pilot_synthetic_dryrun/
