    {"start":0.4166666667,"end":2.5366666667,"text":"Two shots. That's all it took."},
    {"start":3.125,"end":5.3,"text":"Ten past four that Friday morning,"},
    {"start":5.3,"end":8.45,"text":"crouched behind my own bumper\nin a hospital garage,"},
    {"start":8.45,"end":11.685,"text":"I learned what a life ending\nsounds like in concrete."},
    {"start":12.5,"end":15.4280833333,"text":"Go back inside, Dr. Marlowe.\nYou were never here."}
